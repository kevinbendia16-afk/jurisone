// JurisOne — modelo de dados (Fase 1). Banco: SQLite (dev). Trocar provider p/ postgresql na nuvem.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  createdAt DateTime @default(now())
}

model Cliente {
  id           String   @id @default(cuid())
  tipo         String   @default("PF") // PF | PJ
  nome         String
  cpfCnpj      String?
  telefone     String?
  email        String?
  status       String   @default("ativo") // potencial | ativo | inativo | arquivado | inadimplente
  responsavel  String?
  observacoes  String?
  rg           String?
  nascimento   DateTime?
  profissao    String?
  estadoCivil  String?
  endereco     String?
  cidade       String?
  uf           String?
  cep          String?
  tags         String?  // separadas por vírgula
  origem       String?  // como chegou ao escritório (indicação, site, etc.)
  createdAt    DateTime @default(now())

  processos      Processo[]
  prazos         Prazo[]
  lancamentos    LancamentoFinanceiro[]
  valoresTerceiro ValorTerceiro[]
  tarefas        Tarefa[]
  eventos        Evento[]
  documentos     Documento[]
}

model Processo {
  id         String   @id @default(cuid())
  clienteId  String
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  numeroCnj  String?
  titulo     String
  area       String   @default("Cível")
  status     String   @default("ativo") // consulta | ativo | recurso | encerrado ...
  prioridade String   @default("normal") // normal | alta | urgente
  valorCausa Float?
  poloAtivo    String?
  poloPassivo  String?
  advContrario String?
  vara         String?
  comarca      String?
  orgao        String?
  createdAt  DateTime @default(now())

  movimentacoes  Movimentacao[]
  prazos         Prazo[]
  lancamentos    LancamentoFinanceiro[]
  valoresTerceiro ValorTerceiro[]
  tarefas        Tarefa[]
  eventos        Evento[]
  documentos     Documento[]
}

model Movimentacao {
  id         String   @id @default(cuid())
  processoId String
  processo   Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  data       DateTime @default(now())
  descricao  String
}

model Prazo {
  id           String   @id @default(cuid())
  titulo       String
  processoId   String?
  processo     Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
  clienteId    String?
  cliente      Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  dataInicio   DateTime
  dataFatal    DateTime
  dias         Int?
  tipoContagem String   @default("uteis") // uteis | corridos
  prioridade   String   @default("normal")
  status       String   @default("pendente") // pendente | cumprido | cancelado
  createdAt    DateTime @default(now())
}

model LancamentoFinanceiro {
  id         String   @id @default(cuid())
  tipo       String   // entrada | saida
  origem     String   @default("honorario") // honorario | despesa | custa | repasse | outro
  descricao  String
  valor      Float
  valorPago  Float    @default(0) // quanto já foi recebido (baixa parcial)
  data       DateTime @default(now())
  vencimento DateTime?
  status     String   @default("aberto") // aberto | parcial | pago | atrasado
  parcelaNum   Int?     // nº desta parcela (1..N)
  parcelaTotal Int?     // total de parcelas do grupo
  grupoParcela String?  // id que agrupa as parcelas de um mesmo parcelamento
  clienteId  String?
  cliente    Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  processoId String?
  processo   Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

// Documentos / GED — arquivos anexados a cliente/processo (procurações, petições, contratos).
model Documento {
  id         String   @id @default(cuid())
  nome       String   // nome do arquivo
  categoria  String   @default("outro") // procuracao | peticao | contrato | comprovante | decisao | outro
  mime       String?
  tamanho    Int      @default(0) // bytes
  conteudo   String   // base64 do arquivo
  clienteId  String?
  cliente    Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  processoId String?
  processo   Processo? @relation(fields: [processoId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

// Precatórios / valores de terceiros — dinheiro do cliente, NÃO é receita do escritório.
model ValorTerceiro {
  id            String   @id @default(cuid())
  clienteId     String
  cliente       Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  processoId    String?
  processo      Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
  tipo          String   @default("precatorio") // precatorio | rpv | acordo | alvara | deposito_judicial
  valorBruto    Float    @default(0)
  honorarioPct  Float    @default(0)
  custas        Float    @default(0)
  irRetido      Float    @default(0)
  // honorarioValor e valorLiquido são calculados no backend e persistidos p/ relatórios
  honorarioValor Float   @default(0)
  valorLiquido  Float    @default(0)
  tribunal      String?
  enteDevedor   String?
  dataPrevista  DateTime?
  status        String   @default("aguardando") // aguardando | recebido | repassado
  createdAt     DateTime @default(now())
}

// Agenda — eventos categorizados para o advogado se planejar.
model Evento {
  id         String   @id @default(cuid())
  titulo     String
  // categoria: audiencia | prazo | reuniao_cliente | novo_cliente | revisar_processo |
  //            diligencia | tarefa | prazo_interno | outro
  categoria  String   @default("outro")
  inicio     DateTime
  fim        DateTime?
  diaInteiro Boolean  @default(false)
  local      String?
  descricao  String?
  status     String   @default("agendado") // agendado | concluido | cancelado
  clienteId  String?
  cliente    Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  processoId String?
  processo   Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

model Tarefa {
  id         String   @id @default(cuid())
  titulo     String
  descricao  String?
  status     String   @default("pendente") // pendente | em_andamento | concluida | cancelada
  prioridade String   @default("normal")
  prazo      DateTime?
  clienteId  String?
  cliente    Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  processoId String?
  processo   Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}
