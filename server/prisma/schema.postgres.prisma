// JurisOne - modelo de dados (Fase 1). Versao PostgreSQL (nuvem).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  createdAt DateTime @default(now())
}

model Cliente {
  id           String   @id @default(cuid())
  tipo         String   @default("PF")
  nome         String
  cpfCnpj      String?
  telefone     String?
  email        String?
  status       String   @default("ativo")
  responsavel  String?
  observacoes  String?
  createdAt    DateTime @default(now())

  processos      Processo[]
  prazos         Prazo[]
  lancamentos    LancamentoFinanceiro[]
  valoresTerceiro ValorTerceiro[]
  tarefas        Tarefa[]
  eventos        Evento[]
}

model Processo {
  id         String   @id @default(cuid())
  clienteId  String
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  numeroCnj  String?
  titulo     String
  area       String   @default("Civel")
  status     String   @default("ativo")
  prioridade String   @default("normal")
  valorCausa Float?
  createdAt  DateTime @default(now())

  movimentacoes  Movimentacao[]
  prazos         Prazo[]
  lancamentos    LancamentoFinanceiro[]
  valoresTerceiro ValorTerceiro[]
  tarefas        Tarefa[]
  eventos        Evento[]
}

model Movimentacao {
  id         String   @id @default(cuid())
  processoId String
  processo   Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  data       DateTime @default(now())
  descricao  String
}

model Prazo {
  id           String   @id @default(cuid())
  titulo       String
  processoId   String?
  processo     Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
  clienteId    String?
  cliente      Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  dataInicio   DateTime
  dataFatal    DateTime
  dias         Int?
  tipoContagem String   @default("uteis")
  prioridade   String   @default("normal")
  status       String   @default("pendente")
  createdAt    DateTime @default(now())
}

model LancamentoFinanceiro {
  id         String   @id @default(cuid())
  tipo       String
  origem     String   @default("honorario")
  descricao  String
  valor      Float
  valorPago  Float    @default(0)
  data       DateTime @default(now())
  vencimento DateTime?
  status     String   @default("aberto")
  parcelaNum   Int?
  parcelaTotal Int?
  grupoParcela String?
  clienteId  String?
  cliente    Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  processoId String?
  processo   Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

// Precatorios / valores de terceiros - dinheiro do cliente, NAO e receita do escritorio.
model ValorTerceiro {
  id            String   @id @default(cuid())
  clienteId     String
  cliente       Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  processoId    String?
  processo      Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
  tipo          String   @default("precatorio")
  valorBruto    Float    @default(0)
  honorarioPct  Float    @default(0)
  custas        Float    @default(0)
  irRetido      Float    @default(0)
  honorarioValor Float   @default(0)
  valorLiquido  Float    @default(0)
  tribunal      String?
  enteDevedor   String?
  dataPrevista  DateTime?
  status        String   @default("aguardando")
  createdAt     DateTime @default(now())
}

// Agenda - eventos categorizados para o advogado se planejar.
model Evento {
  id         String   @id @default(cuid())
  titulo     String
  categoria  String   @default("outro")
  inicio     DateTime
  fim        DateTime?
  diaInteiro Boolean  @default(false)
  local      String?
  descricao  String?
  status     String   @default("agendado")
  clienteId  String?
  cliente    Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  processoId String?
  processo   Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

model Tarefa {
  id         String   @id @default(cuid())
  titulo     String
  descricao  String?
  status     String   @default("pendente")
  prioridade String   @default("normal")
  prazo      DateTime?
  clienteId  String?
  cliente    Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  processoId String?
  processo   Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}
